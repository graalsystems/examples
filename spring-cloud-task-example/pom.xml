<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.1.1</version>
        <relativePath/>
    </parent>

    <groupId>graal.systems</groupId>
    <artifactId>spring-cloud-task-example</artifactId>
    <version>1.0.0-SNAPSHOT</version>
    <name>spring-cloud-task-example</name>
    <description>A Spring Cloud Task for the graal Data Platform</description>

    <organization>
        <name>GRAAL.SYSTEMS</name>
        <url>https://graal.systems</url>
    </organization>

    <licenses>
        <license>
            <name>Apache-2.0</name>
            <url>https://www.apache.org/licenses/LICENSE-2.0</url>
        </license>
    </licenses>

    <properties>
        <!-- The jvm runtime image runs Java 21. -->
        <java.version>21</java.version>
        <spring-cloud-task.version>5.0.2</spring-cloud-task.version>
    </properties>

    <!-- The jvm image carries no library: Spring Boot, Spring Cloud Task and H2 are packaged in the
         executable jar built by spring-boot-maven-plugin. -->
    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-jdbc</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.cloud</groupId>
            <artifactId>spring-cloud-starter-task</artifactId>
            <version>${spring-cloud-task.version}</version>
        </dependency>
        <!-- In-memory task repository: the task's execution is recorded for the duration of the run. -->
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <scope>runtime</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
