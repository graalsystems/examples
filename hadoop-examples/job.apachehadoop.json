{
  "name": "hadoop-word-count-apachehadoop",
  "identity_id": "<IDENTITY_ID>",
  "timeout_seconds": 1800,
  "max_retries": 0,
  "parameters": [
    "s3a://<BUCKET>/hadoop-examples/input",
    "s3a://<BUCKET>/hadoop-examples/output-apachehadoop"
  ],
  "options": {
    "type": "apachehadoop",
    "main_library": {
      "type": "file",
      "key": "<LIBRARY_KEY>"
    },
    "properties": {
      "mapreduce.job.reduces": "2"
    },
    "instance_type": "Standard_Development_D1_v1",
    "env": {}
  }
}
